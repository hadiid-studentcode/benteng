#!/bin/sh
# BENTENG agent: mengirim baris log query DNS (apa adanya) ke server pusat.
# Server yang mem-parse barisnya. Dijalankan tiap menit oleh cron.

SERVER="http://192.168.56.1:8000/api/ingest/dns"
TOKEN="36a748bd3c6e51456afaa23354cd0990"
SENSOR="BTG-02"

BUF=/tmp/benteng-dns.buf
SEND=/tmp/benteng-dns.send
LOCK=/tmp/benteng-agent.lock

# Kunci: kalau agent lain masih jalan (misalnya cron terdaftar dua kali), keluar saja.
mkdir "$LOCK" 2>/dev/null || exit 0
trap 'rmdir "$LOCK"' EXIT

# Pindahkan buffer baru ke antrean kirim. Kalau pengiriman sebelumnya gagal,
# antrean lama tetap ada dan data baru ditambahkan di belakangnya.
if [ -s "$BUF" ]; then
	cat "$BUF" >> "$SEND"
	rm -f "$BUF"
fi
[ -s "$SEND" ] || exit 0

# Berhasil atau tidaknya dinilai dari isi balasan server, bukan dari kode keluar
# wget: server pengembangan (php artisan serve) kadang memutus koneksi setelah
# membalas, sehingga wget melapor gagal padahal data sudah tersimpan.
# Kiriman ulang aman karena server mengabaikan baris yang sudah pernah disimpan.
RESP=$(wget -q -O - \
	--header="X-Sensor-Token: $TOKEN" \
	--header="X-Sensor-Id: $SENSOR" \
	--header="Content-Type: text/plain" \
	--post-file="$SEND" "$SERVER" 2>/dev/null)

case "$RESP" in
	*'"diterima"'*)
		rm -f "$SEND"
		logger -t benteng-agent "terkirim ke server: $RESP"
		;;
	*)
		logger -t benteng-agent "gagal kirim, dicoba lagi menit berikutnya"
		;;
esac
