#!/bin/sh
# BENTENG responder: menarik perintah dari server dan menjalankannya di sensor.
# Perintah dari server berupa baris teks: "<id> <aksi> <ip>".
# aksi: quarantine | unquarantine. Dijalankan terus-menerus oleh procd.

SERVER="http://192.168.56.1:8000"
TOKEN="GANTI-DENGAN-TOKEN-ACAK"
SENSOR="BTG-02"
JEDA=5
# Tiap sekian putaran (12 x 5 dtk = 1 menit) set karantina disamakan dengan server.
SINKRON_TIAP=12

# Pastikan tabel nftables BENTENG ada (idempoten). Halaman karantina dimuat
# terpisah: kalau gagal, pemutusan koneksi tetap berjalan.
pastikan_nft() {
	if ! nft list table inet benteng >/dev/null 2>&1; then
		nft -f /etc/benteng/benteng-nft.conf
		if [ -f /etc/benteng/benteng-portal.nft ] && ! nft -f /etc/benteng/benteng-portal.nft 2>/dev/null; then
			logger -t benteng-responder "halaman karantina tidak aktif (benteng-portal.nft gagal dimuat)"
		fi
	fi
}

# Validasi sederhana bentuk IPv4, supaya nilai aneh tidak masuk ke perintah nft.
ip_valid() {
	echo "$1" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$'
}

# Set nftables hilang saat sensor reboot atau tabel dimuat ulang. Tambahkan lagi
# semua IP yang menurut server sedang dikarantina. Hanya menambah: pelepasan
# tetap lewat perintah "unquarantine" agar tercatat di jejak audit.
sinkron_karantina() {
	wget -q -O - --header="X-Sensor-Token: $TOKEN" "$SERVER/api/sensors/$SENSOR/karantina" 2>/dev/null |
	while read -r ip sisa; do
		if ip_valid "$ip"; then
			nft add element inet benteng karantina_v4 "{ $ip }" 2>/dev/null
		fi
	done
}

# Samakan daftar domain terblokir dengan server lewat file konfigurasi dnsmasq.
# Baris pertama balasan adalah penanda "#benteng <id terbesar> <belum diterapkan>";
# tanpa penanda (server mati atau galat), daftar yang sedang berlaku dipertahankan.
sinkron_blokir() {
	DATA=$(wget -q -O - --header="X-Sensor-Token: $TOKEN" "$SERVER/api/sensors/$SENSOR/blokir" 2>/dev/null)
	KEPALA=$(echo "$DATA" | head -n 1)
	case "$KEPALA" in
		"#benteng "*) ;;
		*) return ;;
	esac

	DIR=$(ls -d /tmp/dnsmasq.*.d 2>/dev/null | head -n 1)
	[ -n "$DIR" ] || return
	CONF="$DIR/benteng-blokir.conf"
	BARU=/tmp/benteng-blokir.baru

	echo "$DATA" | tail -n +2 | while read -r id domain sisa; do
		# Hanya bentuk nama domain yang masuk ke konfigurasi dnsmasq.
		if echo "$domain" | grep -Eq '^[a-z0-9-]+(\.[a-z0-9-]+)+$'; then
			echo "address=/$domain/"
		fi
	done > "$BARU"

	if { [ -s "$BARU" ] || [ -e "$CONF" ]; } && ! cmp -s "$BARU" "$CONF"; then
		cp "$BARU" "$CONF"
		/etc/init.d/dnsmasq restart >/dev/null 2>&1
		logger -t benteng-responder "daftar blokir domain diperbarui: $(wc -l < "$BARU") domain"
	fi
	rm -f "$BARU"

	set -- $KEPALA
	if [ "$3" != "0" ]; then
		wget -q -O /dev/null \
			--post-data="sampai=$2" \
			--header="X-Sensor-Token: $TOKEN" \
			"$SERVER/api/sensors/$SENSOR/blokir/ack" 2>/dev/null
	fi
}

pastikan_nft
sinkron_karantina
PUTARAN=0

while :; do
	RESP=$(wget -q -O - --header="X-Sensor-Token: $TOKEN" "$SERVER/api/sensors/$SENSOR/commands" 2>/dev/null)

	# Setiap baris: "<id> <aksi> <ip>"
	echo "$RESP" | while read -r id aksi ip sisa; do
		[ -z "$id" ] && continue
		if ! ip_valid "$ip"; then
			H="gagal"
		else
			case "$aksi" in
				quarantine)
					if nft add element inet benteng karantina_v4 "{ $ip }" 2>/dev/null; then
						H="ok"
					else
						H="gagal"
					fi
					;;
				unquarantine)
					nft delete element inet benteng karantina_v4 "{ $ip }" 2>/dev/null
					# Menghapus elemen yang sudah tidak ada tetap dianggap berhasil.
					H="ok"
					;;
				*)
					H="gagal"
					;;
			esac
		fi

		wget -q -O /dev/null \
			--post-data="hasil=$H" \
			--header="X-Sensor-Token: $TOKEN" \
			"$SERVER/api/sensors/$SENSOR/commands/$id/ack" 2>/dev/null
		logger -t benteng-responder "$aksi $ip -> $H"
	done

	sinkron_blokir

	PUTARAN=$((PUTARAN + 1))
	if [ $((PUTARAN % SINKRON_TIAP)) -eq 0 ]; then
		pastikan_nft
		sinkron_karantina
	fi

	sleep "$JEDA"
done
